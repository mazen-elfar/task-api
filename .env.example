# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local MongoDB instance)
# Example local: mongodb://localhost:27017/task-api
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/task-api?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/task-api

# JWT Authentication
# IMPORTANT: Provide a secure, high-entropy secret key in production
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins or * for open access)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
